#!/usr/bin/env bash
# Git invokes this only for the Epic profile's corporate HTTPS credential URL.
set -euo pipefail
library="$HOME/.config/dotfiles/shell/epic.bash"
[[ -r $library ]] || { echo 'Epic Git helper requires the optional Epic profile.' >&2; exit 1; }
source "$library"
_epic_require_wsl
_epic_clean_env \
  "CLAUDE_CONFIG_DIR=$HOME/.claude-epic" \
  "CODEX_HOME=$HOME/.codex-epic" \
  "CLAUDE_GATEWAY_USER_CONFIG_FILE=$HOME/.claude-epic/gateway-helper-config.json" \
  "CLAUDE_GATEWAY_CODEX_USER_CONFIG_FILE=$HOME/.codex-epic/claude-gateway.json" \
  "$HOME/.local/bin/claude-gateway" credential-helper "$@"
